# Local backend/Compose configuration; frontend variables are reserved for its initialization.
# Copy to a root .env. See docs/setup.md for consumers and loading rules.

# Backend on the host
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Frontend: VITE_ values are public and must never contain secrets.
FRONTEND_PORT=5173
VITE_API_ORIGIN=http://localhost:8080

# PostgreSQL container and backend connection
POSTGRES_PORT=5432
POSTGRES_DB=bluemoon
POSTGRES_USER=bluemoon
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bluemoon
SPRING_DATASOURCE_USERNAME=bluemoon
SPRING_DATASOURCE_PASSWORD=

# Fill both password values in your untracked .env with the same local-only value.
# Never place real credentials in this template. JWT settings await the auth decision.
